{
  "name": "@repo/api",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "john.chen",
    "url": "https://github.com/john-data-chen/turborepo-starter-kit"
  },
  "scripts": {
    "build": "echo 'Python: no build step'",
    "check-types": "echo 'Python: no type check step'",
    "dev": "uv run uvicorn app.main:app --reload --port 3001",
    "format": "uv run ruff format app tests",
    "init-db": "uv run python -m app.seed",
    "init-db:force": "uv run python -m app.seed --force",
    "lint": "uv run ruff check --fix app tests",
    "start": "uv run uvicorn app.main:app --port 3001",
    "test": "uv run pytest",
    "test:coverage": "uv run pytest --cov=app --cov-report=term-missing --cov-report=html:coverage --cov-report=xml:coverage/coverage.xml",
    "test:watch": "uv run pytest --watch"
  }
}
